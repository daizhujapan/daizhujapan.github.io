---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title}｜${site.name}` : site.name;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&family=Noto+Serif+TC:wght@700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>
          <span class="mark">問</span>
          <span>{site.name}</span>
        </a>
        <nav>
          <a href={`${base}/map/`}>地圖</a>
          <a href={`${base}/questions/`}>問題庫</a>
          <a href={`${base}/itineraries/`}>行程攻略</a>
          <a href={`${base}/about/`}>關於</a>
          <a href={`${base}/contact/`}>聯絡</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          <a href={site.links.youtube}>YouTube</a> ・
          <a href={site.links.instagram}>Instagram</a> ・
          <a href={site.links.threads}>Threads</a>
        </p>
        <p>© {new Date().getFullYear()} {site.name}。圖片出處依各頁面標示。</p>
      </div>
    </footer>
  </body>
</html>
