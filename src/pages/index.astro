---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import questions from '../data/questions.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = questions.filter((q) => q.status !== '已上片').slice(0, 3);
const done = questions.filter((q) => q.status === '已上片');
---
<Base>
  <section class="hero">
    <h1>{site.name}</h1>
    <p>{site.tagline}</p>
    <a class="btn" href={site.links.youtube}>到 YouTube 看影片</a>
    <a class="btn" href={`${base}/questions/`}>瀏覽問題庫</a>
  </section>

  <section>
    <h2>三條主線</h2>
    <div class="cards">
      <div class="card">
        <h3>日本之最</h3>
        <p>每個「最」都附官方來源，先懂為什麼，再決定要不要去。</p>
      </div>
      <div class="card">
        <h3>行程攻略</h3>
        <p>路線、交通、票價與住宿，照著走就能出發。</p>
      </div>
      <div class="card">
        <h3>1000個問題</h3>
        <p>日本旅行的常見疑問，一支影片回答一題。</p>
      </div>
    </div>
  </section>

  <section>
    <h2>接下來要回答的問題</h2>
    <p>1000 題已經全部排好，目前已上片 {done.length} 題。<a href={`${base}/questions/`}>看完整問題庫 →</a></p>
    <div class="cards">
      {latest.map((q) => (
        <div class="card">
          <span class="tag">{q.type}</span>
          <h3>{q.title}</h3>
          <p>{q.id}・{q.area}・預計 {q.date.replace(/-/g, '/')}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
